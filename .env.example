# ===========================================
# AI Code Review Agent — Environment Variables
# ===========================================

# GitHub Personal Access Token (required for GitHub integration)
# Scopes needed: repo, write:discussion
GITHUB_TOKEN=ghp_your_github_token_here

# GitLab Personal Access Token (optional, for GitLab integration)
GITLAB_TOKEN=glpat-your_gitlab_token_here

# Google Gemini API Key (required for AI analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Webhook Secret (recommended — used to verify webhook signatures)
WEBHOOK_SECRET=your_webhook_secret_here

# Flask Secret Key
SECRET_KEY=change_this_to_a_random_string

# Server Port
PORT=5000

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
